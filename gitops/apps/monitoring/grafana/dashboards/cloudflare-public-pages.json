        "targets": [
          {
            "editorMode": "code",
            "expr": "probe_duration_seconds{job=\"cloudflare-public-pages\"}",
            "instant": false,
            "legendFormat": "{{instance}}",
            "range": true,
            "refId": "A"
          }
        ],
        "title": "External probe duration",
        "type": "timeseries"
      }
    ],
    "refresh": "30s",
    "schemaVersion": 42,
    "tags": [
      "blackbox",
      "cloudflare",
      "availability"
    ],
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-6h",
      "to": "now"
